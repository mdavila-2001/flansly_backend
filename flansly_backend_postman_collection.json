{
	"info": {
		"_postman_id": "flansly-backend-api-collection",
		"name": "Flansly Backend API",
		"description": "Colección de Postman para probar el Backend de Flansly (Arquitectura Limpia y SOLID). Incluye pruebas automatizadas para capturar tokens de autenticación y flujos de negocio del Creador y Seguidor (Paywall, Donación, Favoritos, Feed).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Autenticación (Auth)",
			"item": [
				{
					"name": "Registrar Creador",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"master_chef_creator\",\n    \"email\": \"creator@flansly.com\",\n    \"password\": \"flan12345\",\n    \"displayName\": \"Flan Creador Extraordinario\",\n    \"role\": \"creator\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"register"
							]
						}
					},
					"response": []
				},
				{
					"name": "Registrar Seguidor",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"flan_lover_follower\",\n    \"email\": \"follower@flansly.com\",\n    \"password\": \"seg12345\",\n    \"displayName\": \"Follower Amante de Flanes\",\n    \"role\": \"follower\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"register"
							]
						}
					},
					"response": []
				},
				{
					"name": "Login Creador",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"if (response && response.token) {",
									"    pm.environment.set(\"creator_token\", response.token);",
									"    pm.environment.set(\"creator_id\", response.user.id);",
									"    console.log(\"✅ Token y ID del Creador configurados en el entorno.\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"identity\": \"creator@flansly.com\",\n    \"password\": \"flan12345\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "Login Seguidor",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"if (response && response.token) {",
									"    pm.environment.set(\"follower_token\", response.token);",
									"    pm.environment.set(\"follower_id\", response.user.id);",
									"    console.log(\"✅ Token y ID del Seguidor configurados en el entorno.\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"identity\": \"follower@flansly.com\",\n    \"password\": \"seg12345\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Creador (Creator)",
			"item": [
				{
					"name": "Actualizar Meta (Support Goal)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{creator_token}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Comprar un horno nuevo para flanes\",\n    \"description\": \"Necesito llegar a 100 flanes donados para mejorar la cocina.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/creator/goal",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"creator",
								"goal"
							]
						}
					},
					"response": []
				},
				{
					"name": "Crear Publicación (Post)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"if (response && response.id) {",
									"    pm.environment.set(\"post_id\", response.id);",
									"    console.log(\"✅ ID del Post guardado para interactuar.\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{creator_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "contentText",
									"value": "Hola fans! Esta es una publicación exclusiva con la receta secreta del mejor flan casero 🍮✨",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/creator/posts",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"creator",
								"posts"
							]
						}
					},
					"response": []
				},
				{
					"name": "Listar Publicaciones (Creator Feed)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{creator_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/creator/posts",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"creator",
								"posts"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Seguidor (Follower)",
			"item": [
				{
					"name": "Comentar - Intento fallido (Paywall Bloqueado)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 400 por Paywall\", function () {",
									"    pm.response.to.have.status(400);",
									"    const response = pm.response.json();",
									"    pm.expect(response.error).to.include(\"Acceso bloqueado: Debes apoyar económicamente\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{follower_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"content\": \"Tratando de comentar gratis pero hay paywall...\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/follower/posts/{{post_id}}/comments",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"follower",
								"posts",
								"{{post_id}}",
								"comments"
							]
						}
					},
					"response": []
				},
				{
					"name": "Donar / Apoyar Creador (Compra Flanes)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 201 Donación Creada\", function () {",
									"    pm.response.to.have.status(201);",
									"    const response = pm.response.json();",
									"    pm.expect(response.totalAmount).to.eql(50); // 5 flanes * Bs 10 = 50",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{follower_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"creatorId\": \"{{creator_id}}\",\n    \"quantity\": 5\n}"
						},
						"url": {
							"raw": "{{base_url}}/follower/donate",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"follower",
								"donate"
							]
						}
					},
					"response": []
				},
				{
					"name": "Comentar - Éxito (Después de Donación)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 201 Comentario Privado Creado\", function () {",
									"    pm.response.to.have.status(201);",
									"    const response = pm.response.json();",
									"    pm.expect(response.content).to.eql(\"¡Increíble receta, valió cada flan! 🍮❤️\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{follower_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"content\": \"¡Increíble receta, valió cada flan! 🍮❤️\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/follower/posts/{{post_id}}/comments",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"follower",
								"posts",
								"{{post_id}}",
								"comments"
							]
						}
					},
					"response": []
				},
				{
					"name": "Feed de Creadores Apoyados",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code es 200 Feed Exclusivo cargado\", function () {",
									"    pm.response.to.have.status(200);",
									"    const response = pm.response.json();",
									"    pm.expect(response).to.be.an('array');",
									"    pm.expect(response.length).to.be.greaterThan(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{follower_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/follower/feed",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"follower",
								"feed"
							]
						}
					},
					"response": []
				},
				{
					"name": "Agregar / Remover Favorito (Toggle)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{follower_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/follower/favorites/{{creator_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"follower",
								"favorites",
								"{{creator_id}}"
							]
						}
					},
					"response": []
				}
			]
		}
	],
